#!/usr/bin/env bash
## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## 
## Internet test with multiple aggressive
## assurances checked DNS and HTTP (proxy etc.).
################################################
## Internet test to freebsd.org (inet_test)
## of 0=success | 1=failed
## BSD/MIT Licensed. - shadowbq
## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## 
## (~)$ host -t SOA -W 1 freebsdzzz.org
## Host freebsdzzz.org not found: 3(NXDOMAIN)
## (~)$ echo $?e
## 1
## (~)$ host -t SOA -W 1 freebsd.org
## ;; connection timed out; no servers could be reached
## (~)$ echo $?
## 1
## (~)$ host -t SOA -W 1 freebsd.org
## freebsd.org has SOA record ns0.freebsd.org. hostmaster.freebsd.org. 2013122006 3600 900 604800 600
## (~)$ echo $?
## 0
###############################################
## Spider Google to ensure http is properly working
## (~)$ wget -q spider http://google.com
## Return values(rtv)
## 0 No problems occurred.
## 1 Generic error code.
## 2 Parse error—for instance, when parsing command-line options, the '.wgetrc' or '.netrc'...
## 3 File I/O error.
## 4 Network failure. (No DNS resolution of google.com)
## 5 SSL verification failure.
## 6 Username/password authentication failure.
## 7 Protocol errors.
## 8 Server issued an error response (Proxy failures)
## ## ## ## ## ## ## ## ## ## ## ## ## ## ## ## 
BGREEN='\033[1;32m'
GREEN='\033[0;32m'
BRED='\033[1;31m'
RED='\033[0;31m'
BBLUE='\033[1;34m'
BLUE='\033[0;34m'
BYELLOW='\033[1;33m'
YELLOW='\033[0;33m'
NORMAL='\033[00m'

dns_test_host="freebsd.org"
www_test_url="http://google.com"

function echo_err { echo -ne "${RED}"; cat <<< "$@" 1>&2; echo -ne "${NORMAL}";}

# Parse command line arguments
VERBOSE=false
while [[ $# -gt 0 ]]; do
  case $1 in
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    -f|--fast)
      FAST=true
      shift
      ;;
    *)
      shift
      ;;
  esac
done

host -t SOA -W 1 $dns_test_host > /dev/null
if [ $? -eq 0 ]; then
  rtv=0
  if [ "$VERBOSE" = true ]; then
      echo -e "${GREEN}DNS resolution working.${NORMAL}"
  fi
  if [ "$FAST" = true ]; then
    exit $rtv
  else
    command -v wget >/dev/null 2>&1
    if [ $? -eq 0 ]; then
      wget -q --spider $www_test_url
      case $? in
        4)
          echo_err "Network failure."
          rtv=4
          ;;
        5)
          echo_err "SSL verification failure."
          rtv=5
          ;;
        6)
          echo_err "Username/password authentication failure."
          rtv=6
          ;;
        7)
          echo_err "Protocol errors."
          rtv=7
          ;;
        8)
          echo_err "Possible Proxy Issue. Server issued an error response."
          rtv=8
          ;;
        *)
          rtv=$?
          ;;
      esac
    else
      # wget not found, try curl
      command -v curl >/dev/null 2>&1
      if [ $? -eq 0 ]; then
        curl -s -o /dev/null -I $www_test_url
        rtv=$?
        if [ $rtv -ne 0 ]; then
          echo_err "curl failed with return value: $rtv"
        fi
      else 
        echo_err "curl & wget not in default path missing.(may exist in homebrew etc.)"
        rtv=$?
      fi
    fi
  fi
else 
  echo_err "DNS resolution failed."
  rtv=$?
fi

# Print success message if verbose and no error
if [ "$VERBOSE" = true ] && [ ${rtv:-1} -eq 0 ]; then
  echo -e "${GREEN}Internet connected.${NORMAL}"
fi

exit $rtv